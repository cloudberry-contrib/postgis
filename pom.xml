<!--
  Apache RAT (Release Audit Tool) configuration for the PostGIS-for-Cloudberry
  packaging assets.

  IMPORTANT: this RAT run is deliberately scoped to devops/** ONLY. The rest of
  this repository (postgis/, utility/, the top-level LICENSE, ...) is upstream
  PostGIS, licensed under GPL v2 — it must NOT be scanned for Apache license
  headers. Only the Apache-licensed packaging assets we add under devops/ are
  audited here.

  Run locally with:
    mvn clean verify -Drat.consoleOutput=true
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.apache.cloudberry</groupId>
  <artifactId>apache-cloudberry-postgis-devops</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.rat</groupId>
        <artifactId>apache-rat-plugin</artifactId>
        <version>0.16.1</version>
        <configuration>
          <consoleOutput>true</consoleOutput>

          <!-- Audit ONLY the Apache-licensed packaging assets under devops/. -->
          <includes>
            <include>devops/**</include>
          </includes>

          <excludes>
            <!--
                Ubuntu debian packaging files (control, changelog, compat,
                source/format, ...) use strict formats that do not support
                comment headers, so they cannot carry an ASF license header.
                Exclude the whole directory from the RAT scan.
            -->
            <exclude>devops/build/packaging/deb/ubuntu22.04/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
